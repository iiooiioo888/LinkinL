# LinkinL 本機編排用環境變數（不含 API 金鑰）
# 複製: cp .env.linkinl.example .env.linkinl
# 實際 LLM / Redis 等請在 Linkin 主倉的 .env 設定（見下方 LINKIN_ENV_FILE）

# ===== Linkin 執行目錄（install.sh 預設為 ./linkin-runtime）=====
LINKIN_ROOT=/absolute/or/relative/path/to/linkin-runtime
# Linkin 主倉內的 .env（後端讀取）
LINKIN_ENV_FILE=${LINKIN_ROOT}/.env

# ===== 本機服務 URL（與 Linkin README 埠號一致）=====
# 後端 FastAPI
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# 前端 Vite 開發伺服器
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3001
FRONTEND_URL=http://127.0.0.1:3001

# OPC UA 微服務
OPC_SERVICE_HOST=127.0.0.1
OPC_SERVICE_PORT=8001
OPC_SERVICE_URL=http://127.0.0.1:8001

# ===== 依賴服務（Docker Compose 或本機）=====
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379/0
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8100

# ===== OPC 開發／模擬（對應 Linkin docker-compose.dev 覆蓋）=====
# 本機無真實 PLC 時可開模擬；正式環境請關閉
OPC_SIM_ENABLED=true
OPC_SIM_PORT=4840
OPC_SERVER_URL=opc.tcp://127.0.0.1:4840/freeopcua/server/

# ===== 選用：MineMCP（預設 3000，與前端 3001 錯開）=====
# EVOL_MC_MCP_URL=http://127.0.0.1:3000

# ===== LinkinL manifest（通常勿手改）=====
LINKINL_MANIFEST=./linkinl.json
